# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key (server-side only, preferred: sb_secret_...)
# Falls back to service role key if unset. Never expose in browser code.
SUPABASE_SECRET_KEY=
# Legacy alternative (server-side only)
SUPABASE_SERVICE_ROLE_KEY=

# AI Provider (BharatCode)
# Optional: Required for resume extraction
BHARATCODE_API_KEY=
# BHARATCODE_BASE_URL=https://bharatcode.ai/api/model/v1
# BHARATCODE_MODEL=deepseek-v4.1-flash

# Billing (Razorpay) — server-side only, never VITE_ prefixed
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Annual Pro price in paise (server amount authority for order creation)
PRO_ANNUAL_PRICE_PAISE=199900
CURRENCY=INR

# Custom domains (Cloudflare for SaaS) — server-side only
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
# Origin that serves platform profiles (Worker)
PLATFORM_PROFILE_ORIGIN=https://api.example.com

# Platform public base host for username.<domain> routes (no domain purchased this pass)
# PUBLIC_BASE_HOST=example.com

# .CV provider (Ola) — disabled by default; live quote required before any purchase
DOTCV_ENABLED=false
DOTCV_PURCHASE_ENABLED=false
# DOTCV_API_BASE_URL=
# DOTCV_API_KEY=

# Rate limiting
RATE_LIMIT_KEY_SECRET=

# Application
ENVIRONMENT=development
