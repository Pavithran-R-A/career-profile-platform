# ─── REQUIRED: Base App ────────────────────────────────────────

# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ─── REQUIRED: Server-Side ─────────────────────────────────────

# Supabase secret key (preferred: sb_secret_...)
# Falls back to service role key if unset. Never expose in browser code.
SUPABASE_SECRET_KEY=
# Legacy alternative (server-side only)
SUPABASE_SERVICE_ROLE_KEY=

# ─── REQUIRED FOR PUBLIC LAUNCH: Support / Legal ──────────────

# Public values rendered on the Contact and legal pages.
VITE_SUPPORT_EMAIL=
# Optional public phone and operator details.
VITE_SUPPORT_PHONE=
VITE_OPERATOR_NAME=
VITE_OPERATOR_ADDRESS=

# ─── OPTIONAL: Environment / CORS ─────────────────────────────

# development | preview | production
# In development, localhost origins are automatically allowed.
# In production, only origins listed in ALLOWED_ORIGINS receive CORS headers.
ENVIRONMENT=development
# Comma-separated list of allowed CORS origins (production/preview only)
# ALLOWED_ORIGINS=https://app.example.com

# ─── OPTIONAL: AI Provider (BharatCode) ───────────────────────

# Required for resume extraction and recruiter AI
BHARATCODE_API_KEY=
# BHARATCODE_BASE_URL=https://bharatcode.ai/api/model/v1
# BHARATCODE_MODEL=deepseek-v4.1-flash

# Optional external features are explicit opt-in.
# Missing/false = disabled in every environment.
# Set true only after the corresponding credentials/configuration are ready.
BILLING_ENABLED=false
DOMAINS_ENABLED=false
RECRUITER_AI_ENABLED=false   # recruiter Q&A panel on public profiles

# ─── OPTIONAL: Billing (Razorpay) ─────────────────────────────

# Server-side only, never VITE_ prefixed
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Annual Pro price in paise (server amount authority for order creation)
PRO_ANNUAL_PRICE_PAISE=199900
CURRENCY=INR

# ─── OPTIONAL: GitHub Integration ─────────────────────────────

# One convention, exact names. Flow A (OAuth during install) requires ALL
# SIX values: the dashboard shows the Install button only when the complete
# set is configured — a partial configuration truthfully reports
# "GitHub integration is not configured". GITHUB_STATE_SECRET is an
# independent, explicit secret for signed install state (never derived from
# the client secret).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_STATE_SECRET=
GITHUB_APP_SLUG=
# Webhooks are NOT implemented in this beta: no /github/webhook endpoint
# exists. Do not configure a webhook URL or event subscriptions.

# ─── OPTIONAL: Custom Domains (Cloudflare for SaaS) ───────────

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
PLATFORM_PROFILE_ORIGIN=

# Platform public base host for username.<domain> routes
# PUBLIC_BASE_HOST=example.com

# ─── OPTIONAL: .CV Domain Provider (Ola) ─────────────────────

# Disabled by default; live quote required before any purchase
DOTCV_ENABLED=false
DOTCV_PURCHASE_ENABLED=false
# DOTCV_API_BASE_URL=
# DOTCV_API_KEY=

# ─── OPTIONAL: Rate Limiting ──────────────────────────────────

RATE_LIMIT_KEY_SECRET=
