.env
.env.*
!.env.example
!.gitignore

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
pnpm-debug.log*

# Coverage / reports
coverage/

# Playwright
test-results/
playwright-report/
playwright-live-report/
e2e/.artifacts/
# Live-QA run artifacts (traces/screenshots of authenticated sessions)
e2e/.live-artifacts/
e2e/screenshots/
e2e/**-snapshots/

# Workspace-local agent/tooling state
.mimosa/
.freebuff/

# Misc
*.local
